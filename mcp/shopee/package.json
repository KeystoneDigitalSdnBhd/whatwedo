{
  "name": "@keystonedigital/shopee-mcp",
  "version": "0.1.0",
  "description": "MCP server for the Shopee Open Platform v2 (orders, products, payments, logistics, returns) with HMAC-SHA256 signing, shop token lifecycle and PII redaction.",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "author": "Keystone Digital Sdn. Bhd.",
  "bin": {
    "shopee-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "smoke": "node scripts/smoke.mjs",
    "live-check": "tsx scripts/live-check.ts",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
