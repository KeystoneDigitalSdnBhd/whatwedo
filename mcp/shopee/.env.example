# Shopee Open Platform app (console -> App List -> your app). The live and test
# environments have DIFFERENT partner IDs and keys.
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=

# live | test | cn  (cn = mainland-China seller centre host)
SHOPEE_ENV=live

# The shop this instance serves. One instance and one token file per shop.
SHOPEE_SHOP_ID=

# Bootstrap tokens (or leave blank and use shopee_get_auth_url + shopee_exchange_code).
# Refresh tokens rotate on every refresh: set SHOPEE_TOKEN_FILE so they survive restarts.
SHOPEE_ACCESS_TOKEN=
SHOPEE_REFRESH_TOKEN=
SHOPEE_TOKEN_FILE=

# Safety switches
SHOPEE_ENABLE_WRITES=false
SHOPEE_REDACT_PII=true

# Tuning
SHOPEE_TIMEOUT_MS=15000
SHOPEE_MAX_RETRIES=3
SHOPEE_MAX_RESULT_CHARS=100000

# Override (testing / proxies only; https required except localhost)
SHOPEE_API_BASE_URL=
