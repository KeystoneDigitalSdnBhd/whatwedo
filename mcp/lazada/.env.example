# Lazada Open Platform app credentials (console -> App Management)
LAZADA_APP_KEY=
LAZADA_APP_SECRET=

# Seller country gateway: MY | SG | TH | ID | PH | VN
LAZADA_REGION=MY

# Tokens for ONE seller account. Either paste them here, or leave blank and use
# lazada_get_auth_url + lazada_exchange_code, with LAZADA_TOKEN_FILE to persist.
LAZADA_ACCESS_TOKEN=
LAZADA_REFRESH_TOKEN=
LAZADA_TOKEN_FILE=

# Safety switches
LAZADA_ENABLE_WRITES=false
LAZADA_REDACT_PII=true

# Tuning
LAZADA_TIMEOUT_MS=15000
LAZADA_MAX_RETRIES=3
LAZADA_MAX_RESULT_CHARS=100000

# Overrides (testing / proxies only; https required except localhost)
LAZADA_API_BASE_URL=
LAZADA_AUTH_BASE_URL=
