{
  "name": "@keystonedigital/sg-market-intel",
  "version": "0.1.0",
  "description": "Benchmark a Lazada Singapore shop against official Singapore retail, online-share, CPI and public-holiday data from data.gov.sg. CLI, MCP server and library.",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "author": "Keystone Digital Sdn. Bhd.",
  "bin": {
    "sgmi": "dist/cli.js",
    "sgmi-mcp": "dist/mcp/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "smoke": "node scripts/smoke.mjs",
    "live-check": "tsx scripts/live-check.ts",
    "cli": "tsx src/cli.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
