# Optional: data.gov.sg API key for higher rate limits (https://data.gov.sg, sign in, API keys)
DATAGOV_API_KEY=
# Cache for downloaded tables (default ~/.cache/sg-market-intel); SGMI_NO_CACHE=1 disables
SGMI_CACHE_DIR=
SGMI_CACHE_TTL_HOURS=12

# Lazada Open Platform app and the shop's tokens (Singapore gateway by default)
LAZADA_APP_KEY=
LAZADA_APP_SECRET=
LAZADA_REGION=SG
LAZADA_ACCESS_TOKEN=
LAZADA_REFRESH_TOKEN=
LAZADA_TOKEN_FILE=

# Behind an HTTPS proxy, Node's fetch needs this (Node >= 22.21)
# NODE_USE_ENV_PROXY=1
