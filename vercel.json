{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Keystone-CDN", "value": "vercel-global-edge" },
        { "key": "X-Keystone-Agent", "value": "ks_sovereign_91a" },
        { "key": "X-Keystone-AI-Engine", "value": "BytePlus-ModelArk-Studio-ap-southeast-1" }
      ]
    },
    {
      "source": "/profiles/(.*)\\.mobileconfig",
      "headers": [
        { "key": "Content-Type", "value": "application/x-apple-aspen-config" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"Keystone-ModelArk-Studio.mobileconfig\"" }
      ]
    }
  ]
}
